# WayForPay
WFP_MERCHANT_ACCOUNT=
# домен, зареєстрований у WFP (без протоколу, напр. punkt-shop.netlify.app)
WFP_MERCHANT_DOMAIN=
WFP_SERVICE_URL=
# live-ключ (використовується коли WFP_TEST_MODE не "true")
WFP_SECRET_KEY=
# тестовий ключ пісочниці (використовується коли WFP_TEST_MODE=true)
WFP_TEST_SECRET_KEY=
WFP_TEST_MODE=false

# Brevo SMTP
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=

# Frontend (вказує, куди cart.js відправляє запит на checkout).
# Parcel підставляє це значення у dist/cart.js на етапі БІЛДУ (не рантайму!) —
# тобто для прод-збірки змінна має бути виставлена в Netlify UI env vars ще ДО build,
# інакше в cart.js спрацює запасний дефолт https://punkt-shop.netlify.app/.netlify/functions/checkout
CHECKOUT_ENDPOINT=

# CORS: origin, з якого дозволено fetch() до checkout/wfp-callback (браузер Webflow-сайту).
# Порожньо = "*" (зручно для локальної розробки; перед проді виставити реальний Webflow-домен,
# напр. https://punkt-otse.webflow.io)
CORS_ALLOWED_ORIGIN=

# Опційно: форвард нормалізованого WFP-callback payload у зовнішню автоматизацію
# (напр. Make.com). Форвард вимкнено, якщо змінна порожня.
MAKE_WEBHOOK_URL=

# Дебаг-лог у wfp-callback.js (тіло колбеку, content-type). "1" — увімкнути.
DEBUG_WFP_CALLBACK=
